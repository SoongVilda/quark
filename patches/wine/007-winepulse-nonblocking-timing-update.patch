Subject: winepulse.drv: Never block the timer loop on a timing update

The timer loop drives the WASAPI period event and waited for every
pa_stream_update_timing_info to complete. If the server stalls, the loop
hangs, the event goes silent and an event-driven client deadlocks. Issue
the update without waiting and read the last-known time, keeping one
update in flight at a time, as Proton does.

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index ef13a1e..5849fc8 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -78,7 +78,7 @@ struct pulse_stream
     SIZE_T tmp_buffer_bytes, held_bytes, peek_len, peek_buffer_len, pa_held_bytes;
     BYTE *local_buffer, *tmp_buffer, *peek_buffer;
     void *locked_ptr;
-    BOOL please_quit, just_started, just_underran;
+    BOOL please_quit, just_started, just_underran, timing_update_pending;
     pa_usec_t mmdev_period_usec;
 
     INT64 clock_lastpos, clock_written;
@@ -413,6 +413,13 @@ static void pulse_op_cb(pa_stream *s, int success, void *user)
     pulse_broadcast();
 }
 
+static void pulse_timing_update_cb(pa_stream *s, int success, void *user)
+{
+    struct pulse_stream *stream = user;
+
+    stream->timing_update_pending = FALSE;
+}
+
 static void silence_buffer(pa_sample_format_t format, BYTE *buffer, UINT32 bytes)
 {
     memset(buffer, format == PA_SAMPLE_U8 ? 0x80 : 0, bytes);
@@ -1583,7 +1590,6 @@ static void pulse_timer_loop(void *args)
     LARGE_INTEGER delay;
     pa_usec_t last_time;
     UINT32 adv_bytes;
-    int success;
 
     pulse_lock();
     delay.QuadPart = -stream->mmdev_period_usec * 10;
@@ -1601,7 +1607,24 @@ static void pulse_timer_loop(void *args)
 
         delay.QuadPart = -stream->mmdev_period_usec * 10;
 
-        wait_pa_operation_complete(pa_stream_update_timing_info(stream->stream, pulse_op_cb, &success));
+        /* Refresh timing without ever waiting on it. This loop is the audio
+         * consumer that drives the WASAPI period event (NtSetEvent below); it
+         * must never block on PulseAudio, the producer/server. A blocking
+         * wait_pa_operation_complete() here can hang forever if the server
+         * stalls, the event then goes silent and the event-driven client
+         * deadlocks. Fire the update and read the last-known time instead:
+         * best-effort phase accuracy, an underrun to silence, never a hang.
+         * One update in flight at a time, as Proton does, so a stalled
+         * server cannot queue one per period. */
+        if (!stream->timing_update_pending)
+        {
+            pa_operation *op = pa_stream_update_timing_info(stream->stream, pulse_timing_update_cb, stream);
+            if (op)
+            {
+                stream->timing_update_pending = TRUE;
+                pa_operation_unref(op);
+            }
+        }
         err = pa_stream_get_time(stream->stream, &now);
         if (err == 0)
         {
