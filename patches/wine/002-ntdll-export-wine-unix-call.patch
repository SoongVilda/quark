Subject: ntdll: Export __wine_unix_call to PE code

Port of Proton's compat___wine_unix_call export. It exposes
__wine_unix_call as a PE export that third-party PE code (the
EasyAntiCheat runtime) can resolve through GetProcAddress or its import
table; it dispatches through __wine_unix_call_dispatcher to the unix side.
Upstream Wine does not export it.

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 8e8a693..d851072 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3419,6 +3419,15 @@ NTSTATUS WINAPI __wine_ctrl_routine( void *arg )
 }
 
 
+/***********************************************************************
+ *              __wine_unix_call
+ */
+NTSTATUS WINAPI compat___wine_unix_call( unixlib_handle_t handle, unsigned int code, void *args )
+{
+    return __wine_unix_call( handle, code, args );
+}
+
+
 /***********************************************************************
  *           __wine_unix_spawnvp
  */
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index 14608fd..b081ccd 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -1773,6 +1773,7 @@
 # Unix interface
 @ stdcall __wine_unix_spawnvp(long ptr)
 @ stdcall __wine_ctrl_routine(ptr)
+@ stdcall __wine_unix_call(int64 long ptr) compat___wine_unix_call
 @ extern -private __wine_syscall_dispatcher
 @ extern -private __wine_unix_call_dispatcher
 @ extern -private -arch=arm64ec __wine_unix_call_dispatcher_arm64ec
