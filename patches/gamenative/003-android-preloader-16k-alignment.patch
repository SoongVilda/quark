Subject: configure: Align the Android Wine preloader for 16 KiB pages

The preloader has separate linker flags and does not inherit the global
Android LDFLAGS alignment. The published GameNative ARM64EC preloader has
4 KiB PT_LOAD alignment; keep the package's 16 KiB guarantee for this
static executable too. Other host platforms and C behavior are unchanged.

diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -1010,7 +1010,7 @@
     enable_wineandroid_drv=${enable_wineandroid_drv:-yes}
     WINE_TRY_CFLAGS([-Wl,-z,defs],[UNIXLDFLAGS="$UNIXLDFLAGS -Wl,-z,defs"])
     WINE_TRY_CFLAGS([-fPIC -Wl,--export-dynamic],[WINELOADER_LDFLAGS="-Wl,--export-dynamic"])
-    WINEPRELOADER_LDFLAGS="-static -nostartfiles -nodefaultlibs -Wl,-Ttext=0x7d400000"
+    WINEPRELOADER_LDFLAGS="-static -nostartfiles -nodefaultlibs -Wl,-Ttext=0x7d400000 -Wl,-z,max-page-size=16384"
 
     WINE_CHECK_SONAME(GLESv2,glFlush)
 
